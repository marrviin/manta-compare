{
  "name": "manta-compare",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "predev": "node scripts/kill-port.mjs && node scripts/sync-material-icons.mjs",
    "prebuild": "node scripts/sync-material-icons.mjs",
    "postinstall": "node scripts/sync-material-icons.mjs",
    "preview": "vite preview",
    "blog": "node scripts/build-blog.mjs && prettier --write website/blog.html website/blog.zh.html \"website/blog/*.html\"",
    "tauri": "tauri",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.css\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@ant-design/icons": "^6.3.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-store": "^2.4.4",
    "antd": "^6.6.2",
    "classnames": "^2.5.1",
    "i18next": "^26.4.1",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "marked": "^18.0.13",
    "material-icon-theme": "^5.38.1",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "stylelint-prettier": "^5.0.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^5.0.0",
    "vitest": "^2.1.9"
  }
}
